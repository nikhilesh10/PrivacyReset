{
  "manifest_version": 3,
  "name": "PrivacyReset",
  "version": "0.2.0",
  "description": "A local-first browser privacy manager with protected website allowlisting.",
  "permissions": ["storage", "alarms", "browsingData"],
  "action": {
    "default_title": "PrivacyReset",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}